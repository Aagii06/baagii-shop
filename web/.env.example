PORT=3770

# Шинэ backend (../backend): дэлгүүрийн API нь /web, зураг нь /file
NEXT_PUBLIC_API_URL=http://localhost:5021/web
NEXT_PUBLIC_FILE_URL=http://localhost:5021/file
# Аль дэлгүүр болох (backend X-Shop-Id): 1 — UVS SHOP, 2 — Ajrug
NEXT_PUBLIC_SHOP_ID=1
# Шинэ хаягт урьдчилан сонгох аймаг (ҮСХ-ны код): 85 — Увс
NEXT_PUBLIC_DEFAULT_CITY_CODE=85
NEXT_PUBLIC_DEFAULT_DISTRICT_CODE=8501

# Хуучин eshop-service gateway — одоохондоо устгахгүй, буцаах бол дээрхийг коммент болгоод эдгээрийг нээнэ.
# NEXT_PUBLIC_API_URL=http://202.179.6.67:5501/api/eshop-service
# NEXT_PUBLIC_FILE_URL=http://202.179.6.67:5501/api/file/file

# Google reCAPTCHA v2 ("Би робот биш") — /contact маягт. Хоосон бол харагдахгүй.
# Түлхүүрийг https://www.google.com/recaptcha/admin дээр v2 Checkbox төрлөөр үүсгэнэ;
# нууц түлхүүрийг backend-ийн RECAPTCHA_SECRET_KEY-д тавина
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=
