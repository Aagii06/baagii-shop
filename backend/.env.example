NODE_ENV=development
PORT=5021

JWT_SECRET=uvs_shop_jwt_secret

# MySQL (config/config.js)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASS=
DB_NAME=uvsshop

# Дэлгүүр бүрийн анхны админ (seeders/20261031000001-seed-admin.js): admin самбарт нэвтрэх утас, нууц үг
ADMIN_PHONE_UVS=
ADMIN_PHONE_AJRUG=
ADMIN_PASSWORD=

# Имэйл (helper/mailHelper.js): Gmail + App password. Хоосон бол илгээхгүй, консолд хэвлэнэ
MAIL_USER_NAME=
MAIL_USER_PASS=

# Android утсан дээрх SMS gateway app (BaagiiCar/sms_gateway_app)-ийн token.
# Тохируулбал OTP санамсаргүй 4 оронтой код болж жинхэнэ SMS-ээр очно
SMS_GATEWAY_TOKEN=
